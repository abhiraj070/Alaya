# ==============================================================================
# Alaya Memory Universe — Environment Configuration
# ==============================================================================

# Backend API Base URL
# Leave empty to utilize Vite's internal development proxy (/api -> http://localhost:8000)
# Or provide the full backend origin if running across custom ports or domains:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Vite Dev Server Port (default: 5173)
VITE_PORT=5173

# Optional Backend WebSocket URL (default: ws://localhost:8000/ws)
VITE_WS_URL=ws://localhost:8000/ws
