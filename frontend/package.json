{
  "name": "alaya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:frontend\" \"npm:dev:universe\" \"npm:dev:worker\"",
    "dev:frontend": "next dev",
    "dev:universe": "npm --prefix ../memory-universe/frontend run dev",
    "dev:worker": "cd ../backend && venv\\Scripts\\python.exe -m arq app.core_tasks.arq_worker.worker.WorkerSettings",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4"
  }
}
